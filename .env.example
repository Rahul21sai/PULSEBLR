# PulseBLR — Environment Variables

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pulseblr?retryWrites=true&w=majority

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── NextAuth / Auth.js ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here
# In production, set to your deployment URL (e.g. https://pulseblr.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── NVIDIA NIM — AI event tagging (PRIMARY LLM) ───────────────────────────────
# Get your free API key at https://build.nvidia.com → sign in → top-right "Get API Key"
NVIDIA_API_KEY=nvapi-...
# Model to use. PICK THIS FROM EVIDENCE, not from the model list: verified
# 2026-08-09 that `z-ai/glm-5.2` and `meta/llama-3.3-70b-instruct` are both listed
# by GET /models on a valid key yet never respond (>25s timeout), while
# llama-3.1-8b-instruct answers in ~376ms. Event classification is a small,
# well-specified task, so the 8B model is the right fit — bigger is not better here.
# Run `npx tsx scripts/check-nvidia-models.ts` to time candidates on your own key.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Leave blank to use the default NVIDIA NIM cloud endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Anthropic Claude — AI event tagging (FALLBACK if NVIDIA key not set) ───────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Email digest (Resend) ───────────────────────────────────────────
# 1. Sign up free at https://resend.com  →  API Keys  →  Create API Key
RESEND_API_KEY=re_...
# 2. Where the daily digest is sent. With the default sender below, this MUST be
#    the same email you signed up to Resend with (test sender only delivers to
#    the account owner until you verify your own domain).
USER_EMAIL=you@example.com
# 3. Sender address. Default (unset) = "PulseBLR <onboarding@resend.dev>", which
#    works with zero setup. To send from your own domain, verify it in Resend
#    (Domains → Add Domain) and set e.g. EMAIL_FROM="PulseBLR <digest@yourdomain.com>"
# EMAIL_FROM=PulseBLR <onboarding@resend.dev>
